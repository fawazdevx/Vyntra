# After deploy
FACTORY_ADDRESS=
BOARD_ADDRESS=
VYNTRA_MARKET_ADDRESS=

# RPC
INDEXER_RPC_URL=https://rpc.bohr.life
INDEXER_CHAIN_ID=968

# Database — local file (default) OR Turso for Vercel
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=
# Local override:
# INDEXER_DATABASE_URL=file:./data/vyntra.sqlite

# Optional
# INDEXER_START_BLOCK=0
# VYNTRA_MARKET_START_BLOCK=0
# INDEXER_POLL_MS=8000
# INDEXER_API_PORT=8787
# INDEXER_SYNC_STALE_SEC=20
# CRON_SECRET=long-random-string
