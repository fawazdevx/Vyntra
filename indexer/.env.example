# After deploy
FACTORY_ADDRESS=
BOARD_ADDRESS=
VYNTRA_MARKET_ADDRESS=
VYNTRA_TOKEN_ADDRESS=
VYNTRA_RESERVE_VAULT_ADDRESS=

# RPC
INDEXER_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
INDEXER_CHAIN_ID=99801

# Database — local file (default) OR Turso for Vercel
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=
# Local override. Keep this DB dedicated to Elysium Testnet.
# INDEXER_DATABASE_URL=file:./data/elysium-testnet.sqlite

# Optional
# INDEXER_START_BLOCK=0
# VYNTRA_MARKET_START_BLOCK=0
# VYNTRA_RESERVE_START_BLOCK=0
# INDEXER_POLL_MS=8000
# INDEXER_API_PORT=8787
# INDEXER_SYNC_STALE_SEC=20
# INDEXER_MARKET_CATCHUP_CHUNKS=10  # local default 10; Vercel default 1
# VYNTRA_RESERVE_CATCHUP_CHUNKS=10  # local default 10; Vercel default 1
# CRON_SECRET=long-random-string
