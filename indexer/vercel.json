{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/health" },
    { "source": "/api/v1/:path*", "destination": "/api/app" },
    { "source": "/api/cron/:path*", "destination": "/api/app" }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 0 * * *"
    }
  ]
}
