# BOT Chain mainnet indexer. Use its own Turso database, separate from testnet.
INDEXER_CHAIN_ID=677
INDEXER_RPC_URL=https://rpc.botchain.ai

# Fill in from the confirmed mainnet deployment output.
FACTORY_ADDRESS=
BOARD_ADDRESS=
VYNTRA_MARKET_ADDRESS=
VYNTRA_TOKEN_ADDRESS=

# Set to each contract's actual deployment / seed event block.
INDEXER_START_BLOCK=
VYNTRA_MARKET_START_BLOCK=

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional production tuning
INDEXER_LOG_CHUNK=2000
INDEXER_MARKET_CATCHUP_CHUNKS=1
INDEXER_SYNC_STALE_SEC=20
