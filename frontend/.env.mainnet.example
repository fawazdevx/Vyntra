# Copy into the frontend deployment environment after mainnet contracts are deployed.
# BOT Chain mainnet: https://rpc.botchain.ai, chain ID 677.
VITE_CHAIN_ID=677

# Populate from the confirmed Forge deployment output.
VITE_FACTORY_ADDRESS=
VITE_VYNTRA_TOKEN=
VITE_VYNTRA_MARKET=
VITE_BUYBACK_VAULT=
VITE_FEE_ROUTER=
VITE_BOARD_ADDRESS=
VITE_KEEPER_ADDRESS=

# Mainnet indexer API origin. Use the Render origin as-is, or add /api for Vercel.
VITE_INDEXER_URL=

# Required for production wallet connections.
VITE_WALLETCONNECT_ID=

VITE_BOT_MAINNET_RPC_URL=https://rpc.botchain.ai
