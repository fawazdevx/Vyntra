# Deployed VyntraFactory (set after forge broadcast)
VITE_FACTORY_ADDRESS=

# VYNTRA economy (from Deploy / FinishDeploy logs)
VITE_VYNTRA_TOKEN=
VITE_VYNTRA_MARKET=
VITE_BUYBACK_VAULT=
VITE_FEE_ROUTER=
VITE_BOARD_ADDRESS=
VITE_KEEPER_ADDRESS=

# Optional SQLite indexer API (see /indexer). Falls back to RPC if unset/down.
# Local: http://127.0.0.1:8787
# Vercel indexer project: https://<indexer>.vercel.app/api
# VITE_INDEXER_URL=http://127.0.0.1:8787

# WalletConnect Cloud project id (required for production wallets)
VITE_WALLETCONNECT_ID=

# Optional RPC overrides
VITE_BOT_TESTNET_RPC_URL=https://rpc.bohr.life
VITE_BOT_MAINNET_RPC_URL=https://rpc.botchain.ai

# Recommended for production image uploads (free): https://api.imgbb.com/
# Server also tries Catbox → Litterbox → 0x0.st; paste URL always works in UI.
# VITE_IMGBB_API_KEY=
