# Kinetiq Elysium Testnet (set contract addresses after forge broadcast)
VITE_CHAIN_ID=99801
VITE_FACTORY_ADDRESS=

# VYNTRA economy (from Deploy / FinishDeploy logs)
VITE_VYNTRA_TOKEN=
VITE_VYNTRA_MARKET=
VITE_VYNTRA_RESERVE_TIMELOCK=
VITE_VYNTRA_RESERVE_VAULT=
VITE_VYNTRA_PROMOTION=
VITE_BUYBACK_VAULT=
VITE_FEE_ROUTER=
VITE_BOARD_ADDRESS=
VITE_KEEPER_ADDRESS=

# Optional SQLite indexer API (see /indexer). Falls back to RPC if unset/down.
# Local: http://127.0.0.1:8787
# Vercel indexer project: https://<indexer>.vercel.app/api
# Local indexer: http://127.0.0.1:8787
# Production: https://vyntra-indexer.vercel.app/api
# VITE_INDEXER_URL=https://vyntra-indexer.vercel.app/api

# WalletConnect Cloud project id (required for production wallets)
VITE_WALLETCONNECT_ID=

# Optional Elysium RPC override
VITE_ELYSIUM_TESTNET_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz

# Recommended for production image uploads (free): https://api.imgbb.com/
# Server also tries Catbox → Litterbox → 0x0.st; paste URL always works in UI.
# VITE_IMGBB_API_KEY=
